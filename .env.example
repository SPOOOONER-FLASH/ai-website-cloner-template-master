# Web3Forms public access key for the static inquiry form.
# Obtain the real key with the company email, then copy this file to `.env.local`.
NEXT_PUBLIC_W3F_KEY=replace_with_web3forms_access_key

# Dashboard APIs for scripts/fetch-dashboards-api.mjs (johns machine only; real values go in
# `.env.local`, which git ignores). See docs/collaboration/DATA-DASHBOARDS.md.
BING_WEBMASTER_API_KEY=replace_with_bing_webmaster_api_key
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/johns/.secrets/hyde-reader.json
GSC_SITE=sc-domain:cantonlock.com
GA4_PROPERTY_ID=replace_with_numeric_ga4_property_id
CLARITY_API_TOKEN=replace_with_clarity_data_export_token
