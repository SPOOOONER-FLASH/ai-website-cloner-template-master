# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
# out/ IS committed on purpose.
#
# The server has no build step and the client cannot configure CI secrets, so the built
# site ships in the repository and the server only has to "git pull". Git stores blobs by
# content hash, so the images in out/ share storage with the identical ones in public/ —
# the real cost per build is the HTML and JS delta, not 16 MB.
#
# Consequence: run "npm run build" before committing, or the deployed site lags the source.
# scripts/predeploy-check.mjs is wired into "npm run deploy:prep" to enforce that.
build/
dist/
# Static-export bundle — derived from out/, regenerate rather than track
canton-demo.zip

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Local settings (not project config)
.claude/settings.local.json

# User-specific skills (not part of the template)
.agents/
.claude/skills/customize/
.claude/skills/release/

# Skills installed by `npx skills add`.
#
# The installer writes the skill into .agents/skills/ — already ignored above — and then
# drops a SYMLINK into .claude/skills/ so Claude Code finds it. Committing those symlinks
# would hand the other agents 73 links pointing into a directory git does not carry, which
# is worse than not having them: a broken link looks like a missing file rather than an
# uninstalled skill. Whoever wants them runs the same one-line install; see
# docs/collaboration/SKILLS.md for the exact commands.
#
# `skills-lock.json` is NOT ignored — it is source text recording which repository and
# which content hash each skill came from, which is what makes the install reproducible.
.claude/skills/
.continue/skills/

# Local temp files
temp/
.playwright-cli/
output/playwright/

# Local feature worktrees
.worktrees/

# Agent scratch space. Named tmp/<agent>-<purpose>/ so neither agent deletes the other's
# work — see AGENTS.md. Never tracked, so a deletion here is unrecoverable.
tmp/

# Python bytecode from scripts/*.py
__pycache__/
