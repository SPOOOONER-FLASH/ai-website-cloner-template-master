#!/bin/sh
#
# Refuses a commit while the other agent holds the working-tree lock.
#
# Claude and Codex share one checkout rather than one branch each, so git itself never
# notices when one of them commits over the other's half-finished edits. This is the
# only place that can notice.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Bypass, when you are certain the other side has stopped:
#   node scripts/agent-lock.mjs claim <you> --force
#
# --no-verify also works but skips every other hook too, so prefer --force above.

if [ ! -f scripts/agent-lock.mjs ]; then
  exit 0
fi

if ! node scripts/agent-lock.mjs check; then
  exit 1
fi

if [ ! -f .agent-lock.json ]; then
  echo ""
  echo "  note: committing without a claim. Before your next stretch of work:"
  echo "        node scripts/agent-lock.mjs claim <claude|codex|human> --task \"...\""
  echo ""
fi

exit 0
